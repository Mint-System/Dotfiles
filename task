#!/usr/bin/env bash
# Usage: https://taskfile.build/usage/
set -e

if [[ -f ".env" ]]; then
    # shellcheck source=/dev/null
    source ".env"
fi

help-table() {
    local -a rows
    local max_cmd=7 max_opt=6 max_desc=11

    rows+=("Command|Option|Description")
    rows+=("clone-mint-system-repos||Clone Mint System git repos")
    rows+=("clone-taskfile||Clone the taskfile.build repo")
    rows+=("copy-bin||Copy bin scripts to $HOME/.local/bin")
    rows+=("install|[name]|Install a package.")
    rows+=("uninstall|[name]|Uninstall a package.")
    rows+=("list|[grep]|List all available packages")
    rows+=("list-infomaniak-models||List all available Infomaniak ai models")
    rows+=("set-git-origin||Change git origin to ssh")
    rows+=("setup-passwordless-sudo||Get sudoers entry for passwordless sudo")

    for row in "${rows[@]}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        (( ${#cmd} > max_cmd )) && max_cmd=${#cmd}
        (( ${#opt} > max_opt )) && max_opt=${#opt}
        (( ${#desc} > max_desc )) && max_desc=${#desc}
    done

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_cmd" "Command" \
        "$max_opt" "Option" \
        "$max_desc" "Description"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
        "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
        "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"

    for row in "${rows[@]:1}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        printf '| %-*s | %-*s | %-*s |\n' \
            "$max_cmd" "$cmd" \
            "$max_opt" "$opt" \
            "$max_desc" "$desc"
    done
}

help() {
    local grep_pattern
    echo
    if [[ -n "$1" ]]; then
        grep_pattern="$1"
        help-table | grep -i "$grep_pattern" | column -t -s'|'
    else
        echo "task <command> [options]"
        echo
        echo "commands:"
        echo
        help-table
    fi
    echo
}

# Conditional env vars

if command -v pacman >/dev/null 2>&1; then
    export PACKAGE_MANAGER="pacman"
elif command -v apt >/dev/null 2>&1; then
    export PACKAGE_MANAGER="apt"
elif command -v dnf >/dev/null 2>&1; then
    export PACKAGE_MANAGER="dnf"
else
    export PACKAGE_MANAGER="unknown"
fi

# Import commands

clone-taskfile(){
    if [[ ! -d "$HOME/taskfile.build" ]]; then
        echo -e "\033[38;5;214mGit\033[0m: Clone taskfile repo"
        git clone https://git.taskfile.build "$HOME/taskfile.build"
    else
        echo -e "\033[38;5;214mGit\033[0m: Pull taskfile repo"
        git -C "$HOME/taskfile.build" pull
    fi
}

copy-bin(){
    echo "Copy bin scripts to $HOME/.local/bin"
    mkdir -p "$HOME/.local/bin"
    for file in ./bin/*; do
        if [[ -f "$file" ]]; then
            cp "$file" "$HOME/.local/bin/"
            chmod +x "$HOME/.local/bin/$(basename "$file")"
        fi
    done
}

PACKAGE_ROWS=()
for file in ./packages/*; do
    if [[ -f "$file" ]]; then
        source "$file"
    fi
done

if [[ -d "$HOME/taskfile.build/bin" ]]; then
    for file in "$HOME/taskfile.build/bin/"*; do
        if [[ -f "$file" ]]; then
            source "$file"
        fi
    done
fi

set-git-origin(){
    echo "Change git origin"
    git remote set-url origin git@github.com:Mint-System/Dotfiles.git
}

# Select the KeePass database once and store the selection in
# KEEPASS_DATABASE_FILE / KEEPASS_DATABASE_KEY_FILE, then prompt for
# the database password once.
setup-keepass() {
    if [[ -z "${KEEPASS_DATABASE_FILE:-}" || ! -f "${KEEPASS_DATABASE_FILE:-}" ]]; then
        # Start from a clean slate so stale values don't leak in
        unset KEEPASS_DATABASE_FILE KEEPASS_DATABASE_KEY_FILE
        local line
        while IFS= read -r line; do
            case "$line" in
                KEEPASS_DATABASE_FILE=*)
                    KEEPASS_DATABASE_FILE="${line#KEEPASS_DATABASE_FILE=}" ;;
                KEEPASS_DATABASE_KEY_FILE=*)
                    KEEPASS_DATABASE_KEY_FILE="${line#KEEPASS_DATABASE_KEY_FILE=}" ;;
            esac
        done < <(select-keepass-database)
        KEEPASS_DATABASE_FILE="${KEEPASS_DATABASE_FILE//\"/}"
        KEEPASS_DATABASE_KEY_FILE="${KEEPASS_DATABASE_KEY_FILE//\"/}"
    fi

    if [[ -z "${KEEPASS_DATABASE_FILE:-}" || ! -f "${KEEPASS_DATABASE_FILE:-}" ]]; then
        echo "Failed to select KeePass database." >&2
        exit 1
    fi
    # A key file that no longer exists cannot be used, so drop it
    if [[ -n "${KEEPASS_DATABASE_KEY_FILE:-}" && ! -f "${KEEPASS_DATABASE_KEY_FILE:-}" ]]; then
        unset KEEPASS_DATABASE_KEY_FILE
    fi
    export KEEPASS_DATABASE_FILE
    if [[ -n "${KEEPASS_DATABASE_KEY_FILE:-}" ]]; then
        export KEEPASS_DATABASE_KEY_FILE
    fi

    read -rsp "Enter Keepass database password: " KEEPASS_DATABASE_PASSWORD
    echo
}

list-infomaniak-models() {
    PRODUCT_ID=105852
    setup-keepass
    INFOMANIAK_API_KEY=$(get-pass-from-keepass dotenv/infomaniak_ai_service_api_key "$KEEPASS_DATABASE_PASSWORD")
    curl -G \
         -H "Authorization: Bearer $INFOMANIAK_API_KEY" \
         -H "Content-Type: application/json" \
        "https://api.infomaniak.com/2/ai/$PRODUCT_ID/openai/v1/models" | jq '.data[].id'
}

list() {
    list-table() {
        local -a rows
        local max_cmd=4 max_opt=11

        rows+=("Name|Description")
        # Sorted copy of the rows registered by the package files
        while IFS= read -r row; do
            rows+=("$row")
        done < <(printf '%s\n' "${PACKAGE_ROWS[@]}" | sort)

        for row in "${rows[@]}"; do
            IFS='|' read -r name desc <<< "$row"
            (( ${#name} > max_cmd )) && max_cmd=${#name}
            (( ${#desc} > max_opt )) && max_opt=${#desc}
        done

        printf '| %-*s | %-*s |\n' \
            "$max_cmd" "Name" \
            "$max_opt" "Description"

        printf '|-%*s-|-%*s-|\n' \
            "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
            "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')"

        for row in "${rows[@]:1}"; do
            IFS='|' read -r name desc <<< "$row"
            printf '| %-*s | %-*s |\n' \
                "$max_cmd" "$name" \
                "$max_opt" "$desc"
        done
    }

    echo
    if [[ -n "$1" ]]; then
        list-table | grep -i "$1" | column -t -s'|'
    else
        list-table
    fi
    echo
}

install() {
    if [[ -z "$1" ]]; then echo "\$1 is empty."; exit; fi
    local command="install-$1"
    $command
}

uninstall() {
    if [[ -z "$1" ]]; then echo "\$1 is empty."; exit; fi
    local command="uninstall-$1"
    $command
}

