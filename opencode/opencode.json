{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "infomaniak": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Infomaniak AI",
      "options": {
        "apiKey": "$INFOMANIAK_API_KEY",
        "baseURL": "https://api.infomaniak.com/1/ai/103281/openai"
      },
      "models": {
        "qwen3": {
          "id": "qwen3",
          "name": "qwen3",
          "limit": {
            "context": 5000,
            "output": 5000
          }
        }
      }
    },
    "cortecs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cortecs AI",
      "options": {
        "apiKey": "$CORTECS_API_KEY",
        "baseURL": "https://api.cortecs.ai/v1"
      },
      "models": {
        "devstral-2512": {
          "id": "devstral-2512",
          "name": "devstral-2512",
          "limit": {
            "context": 8000,
            "output": 4000
          }
        }
      }
    }
  },
  "model": "cortecs/devstral-2512"
}