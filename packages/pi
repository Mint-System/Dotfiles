#!/usr/bin/env bash

PACKAGE_ROWS+=("pi|Install Pi cli")

install-pi() {
    echo "Install Pi cli"
    pnpm add -g --ignore-scripts @earendil-works/pi-coding-agent

    echo "Install Pi extensions"
    pi install npm:@juicesharp/rpiv-todo
    pi install npm:pi-context-view

    echo "Setup pi models"
    setup-keepass
    export INFOMANIAK_API_KEY=$(get-pass-from-keepass dotenv/infomaniak_ai_service_api_key "$KEEPASS_DATABASE_PASSWORD")
    export HUGGINGFACE_ACCESS_TOKEN=$(get-pass-from-keepass "dotenv/huggingface_access_token_${USER}" "$KEEPASS_DATABASE_PASSWORD")
    export SCALEWAY_API_KEY=$(get-pass-from-keepass "dotenv/scaleway_api_key_${USER}" "$KEEPASS_DATABASE_PASSWORD")
    export MISTRAL_API_KEY=$(get-pass-from-keepass "dotenv/mistral_api_key_${USER}" "$KEEPASS_DATABASE_PASSWORD")
    mkdir -p ~/.pi/agent
    INFOMANIAK_API_KEY="${INFOMANIAK_API_KEY:-<empty>}"
    HUGGINGFACE_ACCESS_TOKEN="${HUGGINGFACE_ACCESS_TOKEN:-<empty>}"
    SCALEWAY_API_KEY="${SCALEWAY_API_KEY:-<empty>}"
    MISTRAL_API_KEY="${MISTRAL_API_KEY:-<empty>}"
    envsubst '${INFOMANIAK_API_KEY}${HUGGINGFACE_ACCESS_TOKEN}${SCALEWAY_API_KEY}${MISTRAL_API_KEY}'  < ./pi/models.json > ~/.pi/agent/models.json
    echo "Wrote ~/.pi/agent/models.json"

    echo "Symlink pi settings"
    create-symlink "$PWD/pi/settings.json" "$HOME/.pi/agent/settings.json"
}
