#!/usr/bin/env bash

PACKAGE_ROWS+=("llm|Install llm")

install-llm() {
    echo "Install LLM"
    uv tool install llm

    echo "Create symlink to extra openapi models config"
    create-symlink "$PWD/llm/extra-openai-models.yaml" "$(dirname $(llm logs path))/extra-openai-models.yaml"

    echo "Setup api keys"
    setup-keepass
    llm keys set infomaniak --value "$(get-pass-from-keepass dotenv/infomaniak_ai_service_api_key "$KEEPASS_DATABASE_PASSWORD")"
    llm keys set mistral --value "$(get-pass-from-keepass "dotenv/mistral_api_key" "$KEEPASS_DATABASE_PASSWORD")"

    echo "Set default model"
    llm models default Qwen/Qwen3-Embedding-8B
}
