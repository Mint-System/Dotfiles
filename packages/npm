#!/usr/bin/env bash

PACKAGE_ROWS+=("npm|Install npm")

install-npm() {
    echo "Install Node.js"
    if [[ "$PACKAGE_MANAGER" == "pacman" ]]; then
        sudo pacman -S --noconfirm nodejs-lts-krypton
    fi
    if [[ "$PACKAGE_MANAGER" == "pacman" ]]; then
        sudo pacman -S --noconfirm npm
    fi
}
